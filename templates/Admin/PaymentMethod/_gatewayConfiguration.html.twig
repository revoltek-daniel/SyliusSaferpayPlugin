{% set form = hookable_metadata.context.form %}

<div class="col-12 col-md-6">
    {{ form_row(form.gatewayConfig.config.username) }}
</div>
<div class="col-12 col-md-6">
    {{ form_row(form.gatewayConfig.config.password) }}
</div>
<div class="col-12 col-md-6">
    {{ form_row(form.gatewayConfig.config.customer_id) }}
</div>
<div class="col-12 col-md-6">
    {{ form_row(form.gatewayConfig.config.terminal_id) }}
</div>
<div class="col-12 col-md-6">
    {{ form_row(form.gatewayConfig.config.sandbox, { label_attr: { class: 'checkbox-switch' } }) }}
</div>
<div class="col-12 col-md-6">
    {{ form_row(form.gatewayConfig.config.debug, { label_attr: { class: 'checkbox-switch' } }) }}
</div>
{{ form_row(form.gatewayConfig.config.use_authorize) }}
